version = "1.10"

[game]
group_name = "My-Team"
group_id = "thief-team"
sub_game_number = 1
members = ["id-1001", "id-1002"]
repos = { cop = "https://github.com/Moaawiyah/police-agent.git", thief = "https://github.com/Moaawiyah/Ai_thief.git" }

[network]
my_port         = 8802                             # MY MCP server port
opponent_url    = "https://erased-frayed-clubhouse.ngrok-free.dev/mcp"       # the only thing I know about the opponent

[belief]
# Private confidence in scent evidence. Physical scent constants remain signed
# shared terms in game.json; this is only the Thief's fusion tuning.
smell_trust = 4.0

# smell_power shapes HOW a reading's intensity converts to trust. Each cell is
# first normalised against the strongest cell in THAT reading (reading =
# scent / peak), then boosted by 1 + smell_trust * reading**smell_power -- so
# above 1, a cell that is faint relative to this reading's own peak is starved
# harder than the peak itself, regardless of the packet's absolute scale.
# smell_power = 3.0

# [strategy]  -- optional: point at YOUR thief brain subclass (else the shipped heuristic runs)
# thief_class = "my_team.strategy:MyThiefBrain"

[trash_talk]
# The MOVE is always pure Python; Ollama shapes only the verbal hint.
provider = "ollama"              # template | ollama
model = "qwen3:4b"
ollama_url = "http://localhost:11434/api/generate"
timeout_seconds = 5.0
every_n_steps = 1

# [gui] -- how the window paces itself. Purely local presentation: it slows the
# board down so a human can follow it, and slows nothing the opponent can see.
# Leave it at 0 for a league match -- the Police watchdog is still running.
[gui]
step_seconds = 0.0             # pause after each of my moves; replay defaults to 0.5

[llm]
model = "claude-opus-4-8[1m]"    # MY choice; the opponent may differ
step_deadline_seconds = 30       # hard cap on LLM thinking per step

# The mandatory end-of-game report. Private per-peer settings: the recipient
# and the credential paths are mine alone and never belong in the signed
# game.json.
[email]
enabled = false                        # a real API call is opt-in, always
recipient = "rmisegal+uoh26finalgame@gmail.com"
mode = "draft"
credentials_file = "credentials.json"  # downloaded per Appendix Alef; gitignored
token_file = "token.json"              # written by the one-time consent flow; gitignored
